# 2. Import libraries
import torch
import cv2
import matplotlib.pyplot as plt
import numpy as np

from pathlib import Path
from ultralytics import YOLO
from google.colab import files

print("PyTorch version:", torch.__version__)
print("GPU available:", torch.cuda.is_available())

if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))

# 3. Load pretrained YOLO model
print("\nLoading pretrained YOLO11 model...")
model = YOLO("yolo11n.pt")

print("Model loaded successfully!")

# 4. Upload the generated image
print("\nUpload the image containing common objects:")
uploaded = files.upload()

if not uploaded:
    raise ValueError("Please upload an image.")

image_path = next(iter(uploaded.keys()))

# 5. Read and display original image
image = cv2.imread(image_path)

if image is None:
    raise ValueError("Could not read the uploaded image.")

image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

plt.figure(figsize=(12, 7))
plt.imshow(image_rgb)
plt.title("Original Image")
plt.axis("off")
plt.show()

# 6. Run YOLO object detection
print("\nDetecting objects...")

results = model.predict(
    source=image_path,
    conf=0.15,
    imgsz=640,
    save=False,
    verbose=False
)

result = results[0]

# 7. Display detected objects and confidence
print("\n========== DETECTION RESULTS ==========")

if len(result.boxes) == 0:
    print("No objects detected. Try lowering the confidence threshold.")
else:
    for box in result.boxes:
        class_id = int(box.cls[0])
        confidence = float(box.conf[0])
        x1, y1, x2, y2 = map(
            int, box.xyxy[0].tolist()
        )

        print(
            f"Object: {model.names[class_id]:12s} | "
            f"Confidence: {confidence:.2%} | "
            f"Box: ({x1}, {y1}, {x2}, {y2})"
        )

# 8. Filter for your requested COCO classes
target_classes = [
    "bicycle", "person", "car", "motorcycle",
    "bus", "bench", "bird", "cat", "dog",
    "sheep", "cow"
]

detected_classes = [
    model.names[int(box.cls[0])]
    for box in result.boxes
]

print("\n========== TARGET CLASS SUMMARY ==========")

for name in target_classes:
    count = detected_classes.count(name)
    print(f"{name:12s}: {count}")

# 9. Draw bounding boxes and display result
annotated_image = result.plot()
annotated_rgb = cv2.cvtColor(
    annotated_image, cv2.COLOR_BGR2RGB
)

plt.figure(figsize=(16, 10))
plt.imshow(annotated_rgb)
plt.title("YOLO11 Object Detection Results")
plt.axis("off")
plt.show()

# 10. Save annotated image
output_path = "yolo_detection_result.jpg"

cv2.imwrite(output_path, annotated_image)

print("\nDetection completed!")
print("Saved image:", output_path)

# 11. Download result
files.download(output_path)
